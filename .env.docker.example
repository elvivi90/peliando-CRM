# Copiar a .env.docker (no se commitea) para apuntar la app al Postgres
# local de docker-compose.yml en vez de a la base real de Supabase.
# Ver docs/db-local.md para el flujo completo.
#
# Solo hace falta esto: DATABASE_URL y DIRECT_URL. El resto de las
# variables (Supabase Auth, Tiendup) se siguen tomando de .env — el login
# y las llamadas a Tiendup usan los servicios reales igual, solo los DATOS
# de la app (clientes, ventas, etc.) quedan en esta base local.

DATABASE_URL="postgresql://peliando:peliando@localhost:5433/peliando_dev"
DIRECT_URL="postgresql://peliando:peliando@localhost:5433/peliando_dev"
