# Copiar a .env y completar con los datos reales del proyecto de Supabase.
# Project Settings > Database > Connection string (elegir "Prisma" / "Transaction pooler")

# Conexion pooled (pgbouncer, puerto 6543) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexion directa (puerto 5432) — la usa `prisma migrate` para aplicar cambios de schema.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Panel de Tiendup > Configuraciones > API > generar API Key.
TIENDUP_API_KEY="[tiendup-api-key]"

# Panel de Tiendup > Configuraciones > Webhooks > crear webhook con esta URL
# (https://tu-dominio/api/webhooks/tiendup), suscripto SOLO a "orders.payment_paid".
# Tiendup genera un secreto propio ahi mismo — pegarlo tal cual, no inventarlo.
TIENDUP_WEBHOOK_SECRET="[secreto-que-genera-tiendup]"

# Opcional — slug del negocio en la URL de la API (https://{slug}.public-api.tiendup.com).
# TIENDUP_BUSINESS_SLUG="peliando"

# Notificaciones push (Web Push). Generar el par de claves UNA sola vez con
# `npx web-push generate-vapid-keys` y usar las mismas en local y en Vercel:
# si cambian, todas las suscripciones existentes dejan de funcionar.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="[clave-publica]"
VAPID_PRIVATE_KEY="[clave-privada]"
# Contacto para los servicios de push (Google/Apple/Mozilla).
VAPID_SUBJECT="mailto:[email-de-contacto]"

# Secreto para el cron semanal de cobros pendientes (vercel.json). Vercel lo
# manda solo como "Authorization: Bearer ..." si la variable existe en el
# proyecto. Cualquier string largo y aleatorio.
CRON_SECRET="[secreto-aleatorio]"
