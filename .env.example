# Copiar a .env y completar con los datos reales del proyecto de Supabase.
# Project Settings > Database > Connection string (elegir "Prisma" / "Transaction pooler")

# Conexion pooled (pgbouncer, puerto 6543) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexion directa (puerto 5432) — la usa `prisma migrate` para aplicar cambios de schema.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Token secreto propio (elegir cualquier string largo) para validar el webhook de Tiendup.
TIENDUP_WEBHOOK_SECRET="cambiar-por-un-secreto-largo"
